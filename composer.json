{
    "name": "roundly-consulting/tags-for-laravel",
    "description": "Typed taxonomies for any Eloquent model: flat or nested, single- or multi-select, curated or free-form, tenant-scoped and translatable, with autocomplete, usage counts and query scopes.",
    "keywords": [
        "roundly-consulting",
        "laravel",
        "tags",
        "tagging",
        "taxonomy",
        "categories",
        "labels",
        "hierarchical",
        "autocomplete",
        "multilingual"
    ],
    "homepage": "https://roundly-consulting.com/open-source/docs/tags-for-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Andrej Mihaliak",
            "email": "andrej@mihaliak.com",
            "role": "Developer"
        }
    ],
    "support": {
        "docs": "https://roundly-consulting.com/open-source/docs/tags-for-laravel"
    },
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "ext-mbstring": "*",
        "illuminate/auth": "^12.0|^13.0",
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/container": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/events": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0",
        "roundly-consulting/enums-for-laravel": "^1.1.0",
        "roundly-consulting/package-toolkit-for-laravel": "^1.3.0",
        "roundly-consulting/query-builder-for-laravel": "^1.2.1",
        "roundly-consulting/sluggable-for-laravel": "^1.1.3",
        "roundly-consulting/translatable-for-laravel": "^1.1.2"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "nunomaduro/collision": "^8.5",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "roundly-consulting/testing-for-laravel": "^1.6.1"
    },
    "autoload": {
        "psr-4": {
            "RoundlyConsulting\\Tags\\": "src",
            "RoundlyConsulting\\Tags\\Database\\Factories\\": "database/factories"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RoundlyConsulting\\Tags\\Tests\\": "tests"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --no-progress",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage --min=95"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RoundlyConsulting\\Tags\\TagsServiceProvider"
            ],
            "aliases": {
                "Tags": "RoundlyConsulting\\Tags\\Facades\\Tags"
            }
        }
    }
}
